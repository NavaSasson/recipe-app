# Stage 1: Build and test environment
FROM python:3.9-slim AS builder

# Set working directory
WORKDIR /app

# Copy requirements first to leverage Docker cache
COPY tests/e2e-tests/e2e-test-requirements.txt .

# Install build dependencies and clean up in one layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl && \
    pip install --no-cache-dir -r e2e-test-requirements.txt && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /root/.cache/pip/*

# Stage 2: Test runtime
FROM python:3.9-slim AS tester

# Create non-root user
RUN groupadd -r testuser && useradd -r -g testuser testuser

# Install curl for health checks
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy installed dependencies from builder
COPY --from=builder /usr/local/lib/python3.9/site-packages/ /usr/local/lib/python3.9/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Copy test files
COPY tests/e2e-tests/e2e_test.py .

# Set proper permissions
RUN chown -R testuser:testuser /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FLASK_ENV=testing \
    PATH="/usr/local/bin:$PATH"

# Switch to non-root user
USER testuser

# Command to run tests
CMD ["pytest", "-v", "e2e_test.py", "--junitxml=test-results/junit.xml"]